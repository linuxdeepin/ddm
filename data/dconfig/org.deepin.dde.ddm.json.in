            "value": [],
            "serial": 0,
            "flags": [],
            "name": "Namespaces",
            "name[zh_CN]": "命名空间",
            "description": "List of paths bound to Linux namespaces to enter with setns() before starting the user session.",
            "description[zh_CN]": "启动用户会话前通过 setns() 进入的 Linux 命名空间路径列表。",
            "permissions": "readwrite",
            "visibility": "private"
        },
        "x11CursorTheme": {
